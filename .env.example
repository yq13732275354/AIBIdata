# ===== 智能问数 Agent 配置 =====
# DeepSeek（兼容 OpenAI SDK）
DEEPSEEK_API_KEY=sk-your-real-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 本地路径
DUCKDB_PATH=data/ai_bi.duckdb
SQLITE_PATH=data/chat.db
SOURCE_XLSX=/Users/yuqiang123/Desktop/saledata-test.xlsx

# 数据的时间上限：相对时间（本月/上月/本季度）以此为锚
# 系统日期是 2026-11，但数据止于 2025-12，因此必须锚定到 2025-12，避免问到空数据
DATA_ANCHOR_PERIOD=2025-12

# 单机自用，关闭登录
APP_PORT=8000
